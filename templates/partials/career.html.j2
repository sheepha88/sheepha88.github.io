<section id="career" class="section">
  <h2>경력</h2>
  <div class="table-wrap career">
    <table>
      <thead><tr><th scope="col">기간</th><th scope="col">소속</th><th scope="col">직무</th></tr></thead>
      <tbody>
        {% for j in jobs %}
        <tr{% if j.period[1] == '현재' %} class="current"{% endif %}>
          <td class="period">{{ j.period | period }}</td>
          <td><strong>{{ j.org }}</strong></td>
          <td>{{ j.title }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
