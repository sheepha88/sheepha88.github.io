<section class="hero">
  <div class="hero-copy">
    <p class="role"><span class="dot" aria-hidden="true"></span>{{ hero.role }} {{ hero.name }}</p>
    <h1>{{ hero.tagline }}</h1>
    <p class="intro">{{ hero.intro }}</p>
    <p class="hero-contact"><a class="btn" href="mailto:{{ hero.email }}">{{ hero.email }}</a></p>
  </div>
  <ul class="bento">
    {% for h in hero.highlights %}
    <li class="bento-{{ loop.index }}">
      <a href="#{{ h.project }}">
        <span class="value">{{ h.value }}</span>
        <span class="caption">{{ h.text }}</span>
      </a>
    </li>
    {% endfor %}
    <li class="bento-4 stat">
      <span class="value">140<small>개 병원</small></span>
      <span class="caption">의사 80명이 사용하는 B2B SaaS</span>
    </li>
  </ul>
</section>
